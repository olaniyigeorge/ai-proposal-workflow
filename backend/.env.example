PROJECT_NAME="AI Proposal Workflow"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/proposals_db"

# Supabase Auth & Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"
SUPABASE_JWT_SECRET="dev-secret-key-change-in-production"

# Intake Webhook Security (n8n -> FastAPI)
WEBHOOK_SECRET="dev-webhook-secret"
